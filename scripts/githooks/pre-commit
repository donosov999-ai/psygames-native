#!/bin/bash
# psygames-precommit-tsc · VER 1 · 07.09.2026
#
# 🔴 ЗАЧЕМ. За сутки 07.09 координатор ТРИЖДЫ чинил красный `tsc` в `main`,
# приехавший из чужих коммитов, и дважды это была одна и та же ошибка,
# скопированная в соседний файл. Красный main останавливает выпуск для всех.
#
# Правилом это не лечится — правило проверяет тот же, кто его нарушает.
# Поэтому проверка механическая, до коммита.
#
# ⚠️ ГЛАВНОЕ В УСТРОЙСТВЕ: ругается ТОЛЬКО на ошибки в ТВОИХ застейдженных
# файлах. Дерево у нас одно на девять чатов, и в нём всегда лежит чья-то
# недописанная правка; хук, падающий на чужом файле, заблокировал бы всех и был
# бы снесён в первый же день.
#
# ⚠️ FAIL-OPEN: если что-то пошло не так (нет node, нет frontend, tsc не
# запустился) — коммит ПРОПУСКАЕТСЯ. Сломанный хук не должен останавливать
# работу девяти чатов; он страхует, а не охраняет.
#
# Обойти сознательно: git commit --no-verify
set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$root/frontend" ] || exit 0

# Застейдженные файлы TypeScript. Удалённые не проверяем.
staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^frontend/.*\.tsx?$' || true)
[ -z "$staged" ] && exit 0

command -v npx >/dev/null 2>&1 || exit 0

echo "⏳ tsc по вашим файлам (около 15 секунд, обойти: --no-verify)…"
out=$(cd "$root/frontend" && npx tsc --noEmit 2>&1) || true

# Пути в выводе tsc — относительно frontend/. Приводим стейдж к тому же виду.
mine=$(printf '%s\n' "$staged" | sed 's|^frontend/||')

bad=""
while IFS= read -r file; do
  [ -z "$file" ] && continue
  # Строка вида `src/foo.ts(29,9): error TS2339: …` — якорим на начало строки.
  hit=$(printf '%s\n' "$out" | grep -F "$file(" || true)
  [ -n "$hit" ] && bad="$bad$hit"$'\n'
done <<< "$mine"

if [ -n "$bad" ]; then
  echo ""
  echo "🔴 КОММИТ ОСТАНОВЛЕН: в ваших же файлах красный tsc."
  echo ""
  printf '%s' "$bad" | sed 's/^/   /'
  echo ""
  echo "   Это остановило бы выпуск для всех девяти чатов."
  echo "   Починить и повторить, либо осознанно обойти: git commit --no-verify"
  exit 1
fi

echo "✅ tsc по вашим файлам чист"
exit 0
