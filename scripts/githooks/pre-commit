#!/bin/bash
# psygames-precommit-tsc · VER 1 · 07.09.2026
#
# 🔴 ЗАЧЕМ. За сутки 07.09 координатор ТРИЖДЫ чинил красный `tsc` в `main`,
# приехавший из чужих коммитов, и дважды это была одна и та же ошибка,
# скопированная в соседний файл. Красный main останавливает выпуск для всех.
#
# Правилом это не лечится — правило проверяет тот же, кто его нарушает.
# Поэтому проверка механическая, до коммита.
#
# ⚠️ ГЛАВНОЕ В УСТРОЙСТВЕ: ругается ТОЛЬКО на ошибки в ТВОИХ застейдженных
# файлах. Дерево у нас одно на девять чатов, и в нём всегда лежит чья-то
# недописанная правка; хук, падающий на чужом файле, заблокировал бы всех и был
# бы снесён в первый же день.
#
# ⚠️ FAIL-OPEN: если что-то пошло не так (нет node, нет frontend, tsc не
# запустился) — коммит ПРОПУСКАЕТСЯ. Сломанный хук не должен останавливать
# работу девяти чатов; он страхует, а не охраняет.
#
# Обойти сознательно: git commit --no-verify
set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$root/frontend" ] || exit 0

# Застейдженные файлы TypeScript. Удалённые не проверяем.
staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^frontend/.*\.tsx?$' || true)
[ -z "$staged" ] && exit 0

command -v npx >/dev/null 2>&1 || exit 0

echo "⏳ tsc по вашим файлам (около 15 секунд, обойти: --no-verify)…"
out=$(cd "$root/frontend" && npx tsc --noEmit 2>&1) || true

# Пути в выводе tsc — относительно frontend/. Приводим стейдж к тому же виду.
mine=$(printf '%s\n' "$staged" | sed 's|^frontend/||')

bad=""
while IFS= read -r file; do
  [ -z "$file" ] && continue
  # Строка вида `src/foo.ts(29,9): error TS2339: …` — якорим на начало строки.
  hit=$(printf '%s\n' "$out" | grep -F "$file(" || true)
  [ -n "$hit" ] && bad="$bad$hit"$'\n'
done <<< "$mine"

if [ -n "$bad" ]; then
  echo ""
  echo "🔴 КОММИТ ОСТАНОВЛЕН: в ваших же файлах красный tsc."
  echo ""
  printf '%s' "$bad" | sed 's/^/   /'
  echo ""
  echo "   Это остановило бы выпуск для всех девяти чатов."
  echo "   Починить и повторить, либо осознанно обойти: git commit --no-verify"
  exit 1
fi

echo "✅ tsc по вашим файлам чист"

# ─────────────────────────────────────────────────────────────────────────────
# 🔴 ВТОРАЯ ПРОВЕРКА: ПЕРЕЕХАЛ СЛОТ — ОБНОВИ РЕЕСТР, КОТОРЫЙ ЕГО ОПИСЫВАЕТ.
#
# ПОВОД — ОДИН И ТОТ ЖЕ ПРОМАХ ДВАЖДЫ, С ОДНИМ И ТЕМ ЖЕ РЕЕСТРОМ.
#   07.09.2026 — ответ трёх игр переехал в `toolbar`, а `slot-meaning` продолжал
#                утверждать «нижней полосы нет». main стоял красным полдня.
#   11.09.2026 — `phonemic-fluency` объявил `bottom="answer"` (коммит bd048eb9),
#                реестр снова не тронули. Упали `slot-meaning` и
#                `languages-hub-one-look`, чинил их другой чат (15981448).
#
# 📍 ЗАМЕР 11.09.2026, почему одной внимательности мало: экран `phonemic-fluency`
# называют ДВЕНАДЦАТЬ наборов проб, автор правки прогнал пять. Обе упавшие были
# среди семи непрогнанных. Выбрать нужные глазами нельзя — их надо СПРОСИТЬ.
#
# ⚠️ ПОЧЕМУ ИМЕННО `bottom=`, А НЕ «прогони все пробы, называющие файл». Второе
# — ворчание на каждый коммит: оно быстро становится фоном, и его перестают
# читать (тот же довод, по которому в этом репо отказались от continue-on-error).
# `bottom=` — это ровно та строка, изменение которой ломало main оба раза, и
# у неё есть ОДИН обязательный спутник: запись в реестре.
#
# ⚠️ FAIL-OPEN, как и выше: любая неожиданность — пропускаем коммит.
#
# ⚠️ ИМЕНА ПЕРЕМЕННЫХ ЛАТИНИЦЕЙ. Первая редакция этой проверки была написана
# с русскими именами (`реестр`, `игры`) и упала на первом же прогоне: bash
# не принимает не-ASCII идентификаторы, и строка превращается в попытку
# выполнить файл. В репозитории на это есть гейт `shell-scripts-ascii-vars`.
# Комментарии по-русски — можно, имена — нет.
# ─────────────────────────────────────────────────────────────────────────────

registry="frontend/src/__tests__/slot-meaning.test.ts"
games=$(printf '%s\n' "$staged" | grep -E '^frontend/app/games/.*\.tsx$' || true)

if [ -n "$games" ] && ! printf '%s\n' "$staged" | grep -qxF "$registry"; then
  moved=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    was=$(git show "HEAD:$f" 2>/dev/null | grep -c 'bottom=' || echo 0)
    now=$(git show ":$f" 2>/dev/null | grep -c 'bottom=' || echo 0)
    [ "$was" = "$now" ] || moved="$moved   $f: bottom= было $was, стало $now"$'\n'
  done <<< "$games"

  if [ -n "$moved" ]; then
    echo ""
    echo "🔴 КОММИТ ОСТАНОВЛЕН: слот нижней полосы переехал, а реестр не тронут."
    echo ""
    printf '%s' "$moved"
    echo ""
    echo "   Реестр $registry описывает СМЫСЛ слота у каждой игры"
    echo "   (BOTTOM_IS_ANSWER / BOTTOM_IS_EMPTY). Он не украшение: проба"
    echo "   «реестр не врёт про наличие нижней полосы» краснеет у ВСЕХ, кто"
    echo "   возьмёт main, а не только у вас."
    echo ""
    echo "   Что сделать: поправить запись в реестре В ЭТОМ ЖЕ коммите."
    echo "   Заодно спросить, кто ещё описывает экран:"
    echo "     grep -rl \"<имя-экрана>\" frontend/src/__tests__"
    echo ""
    echo "   Осознанно обойти: git commit --no-verify"
    exit 1
  fi
fi

exit 0
