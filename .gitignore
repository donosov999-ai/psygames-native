voice-wiktionary/

# Сборка словника: скачанные исходники и окружение — в репозиторий не идут.
# Идёт только собранный набор (frontend/src/constants/allWordsRu.json) и скрипт.
wordlist-build/.venv/
wordlist-build/__pycache__/
# Скачанные исходники словников — ШАБЛОНАМИ, а не поимённо.
# 06.09.2026 сюда приехали пять новых языков, и каждый принёс по 2-5 файлов
# (до 6 МБ): перечислять их руками — значит забыть на шестом. В репозитории
# живут СКРИПТЫ сборки и готовые JSON, исходники качаются заново.
wordlist-build/*_50k.txt
wordlist-build/*.dic
wordlist-build/*.aff
wordlist-build/*_lexemes.csv
wordlist-build/words_alpha.txt
wordlist-build/first_names.txt
wordlist-build/es_apellidos-*.txt
wordlist-build/es_nombres-propios-*.txt
wordlist-build/ldnoobw_*
wordlist-build/ko_50k.txt
wordlist-build/ru_full.txt
wordlist-build/ar_50k.txt
wordlist-build/ja_full.txt

# Рабочая папка чата «Слова»: замеры, черновики, листы генерации картинок (20 МБ).
# В репозиторий не идёт НИЧЕГО из неё: PROJECT_REF.md закрыт правилом выше, а
# листы 7×8 по 2,5 МБ каждый и нарезка на 56 клеток нужны только на машине.
# Строка стоит здесь потому, что 06.09.2026 чужой `git add -A` уже подмёл дерево
# и увёл работу трёх сессий в чужие коммиты — от такого файлы должен защищать
# .gitignore, а не память о том, что так делать нельзя.
words-chat/
