{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "psygames-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx expo start --web --port 8081"
      ],
      "port": 8081
    },
    {
      "name": "psygames-dist",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend/dist && python3 -m http.server 8099"
      ],
      "port": 8099
    },
    {
      "name": "psygames-counting",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx expo start --web --port ${PORT:-8085}"
      ],
      "port": 8085,
      "autoPort": true
    },
    {
      "name": "psygames-sorting",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx expo start --web --port ${PORT:-8087}"
      ],
      "port": 8087,
      "autoPort": true
    }
  ]
}
