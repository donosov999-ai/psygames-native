/cloze","icon":"create","nameKey":"cloze","descKey":"clozeDesc","type":null},{"route":"/games/lexical-decision","icon":"checkmark-done","nameKey":"lexicalDecision","descKey":"lexicalDecisionDesc","type":null},{"route":"/games/anagrams","icon":"shuffle","nameKey":"anagrams","descKey":"anagramsDesc","type":null},{"route":"/games/phonemic-fluency","icon":"chatbubbles","nameKey":"phonemic","descKey":"phonemicDesc","type":null},{"route":"/games/story-recall","icon":"book","nameKey":"story","descKey":"storyDesc","type":null}],"/games/hearing-hub":[{"route":"/games/phoneme-pairs","icon":"git-compare","nameKey":"phonemePairs","descKey":"phonemePairsDesc","type":null},{"route":"/games/chinese-tones","icon":"musical-note","nameKey":"chineseTones","descKey":"chineseTonesDesc","type":null},{"route":"/games/pseudoword-echo","icon":"mic","nameKey":"pseudowordEcho","descKey":"pseudowordEchoDesc","type":null},{"route":"/games/dictation","icon":"headset","nameKey":"dictation","descKey":"dictationDesc","type":null},{"route":"/games/rhythm-pitch","icon":"musical-notes","nameKey":"rhythmPitch","descKey":"rhythmPitchDesc","type":null}],"/games/languages-hub":[{"route":"/games/words-hub","icon":"text","nameKey":"wordsGroup","descKey":"wordsGroupDesc","type":null},{"route":"/games/hearing-hub","icon":"ear","nameKey":"hearingGroup","descKey":"hearingGroupDesc","type":null}]},"meta":{"/games/span":{"title":"Объём памяти","desc":"Цифры или пространство, прямой или обратный","footnote":""},"/games/mnemonics-hub":{"title":"Мнемотехники","desc":"Привязать новое к тому, что уже помнишь","footnote":"Общий приём: новое запоминается не само по себе, а сцепкой с уже известным — местом, лицом, словом, образом."},"/games/chess-hub":{"title":"Шахматы","desc":"Доска, поля и фигуры: держать позицию в голове и узнавать узор","footnote":"Доска одна, а навыка два. «Доска в уме» убирает позицию из виду и меряет, что вы удержали. «Детский мат» оставляет её на виду и меряет, за сколько секунд вы увидели знакомый узор."},"/games/attention-conflict":{"title":"Конфликт внимания","desc":"","footnote":""},"/games/search-hub":{"title":"Поиск глазами","desc":"Найти нужное среди похожего","footnote":"Общее у всех: цель известна заранее, трудность — в том, что рядом лежит похожее."},"/games/sudoku-hub":{"title":"Судоку: три доски","desc":"Классическая, самурай и фрактальная","footnote":"Правило у всех трёх одно: цифра не повторяется в строке, столбце и блоке. Различается доска. У каждой свой счёт уровней и своя история — партии не смешиваются."},"/games/puzzles-hub":{"title":"Головоломки","desc":"Сорок логических головоломок Саймона Тэтхэма — его движки целиком","footnote":"У каждой головоломки своя лестница сложности: где-то три ступени, где-то шестнадцать"},"/games/spatial-hub":{"title":"Пространство","desc":"Повернуть в уме, растолкать, проложить путь","footnote":"Общее у всех: ход надо просчитать в голове заранее — на поле почти каждый ход выглядит законным и заводит в тупик."},"/games/sorting-hub":{"title":"Сортировка","desc":"Разложить по ёмкостям, где место кончается","footnote":"Обе пробы про один дефицит: не в каком порядке класть, а КУДА — свободных мест меньше, чем предметов."},"/games/counting-hub":{"title":"Счёт","desc":"Числа в уме: пересчёт, прикидка, скорость","footnote":"Разные подходы к одному навыку: удержать число, прикинуть, посчитать быстро, разложить на слагаемые, продолжить ряд."},"/games/words-hub":{"title":"Слова","desc":"Словарь и извлечение слова из памяти","footnote":"От узнавания слова до извлечения его из памяти без подсказки — по нарастанию усилия."},"/games/hearing-hub":{"title":"Слух","desc":"Задание звучит: различить, повторить, назвать тон","footnote":"Почти всем нужен голос в системе: без него упражнение честно говорит об этом и не притворяется. Ритму и высоте голос не нужен — там звучат тоны."},"/games/languages-hub":{"title":"Языки","desc":"Память на слово и память на его звучание","footnote":"Две стороны чужого языка тренируются по-разному: словарь — глазами, произношение — ухом. Поэтому здесь два входа, а не общий список."}},"source":"frontend/src/constants/hubContents.ts","layouts":{"odv999":{"/games/puzzles-hub":["/games/puzzles","/games/puzzles?mode=Slant","/games/puzzles?mode=Black%20Box","/games/puzzles?mode=Guess"],"/games/sudoku-hub":["/games/sudoku","/games/sudoku-samurai","/games/sudoku-fractal","/games/sudoku?mode=towers","/games/sudoku?mode=unequal","/games/puzzles?mode=Solo","/games/puzzles?mode=Towers","/games/puzzles?mode=Unequal","/games/puzzles?mode=Keen","/games/puzzles?mode=Singles","/games/puzzles?mode=Filling","/games/puzzles?mode=Undead"],"/games/spatial-hub":["/games/mental-rotation","/games/spatial-lab?mode=twiddle","/games/spatial-lab?mode=net","/games/puzzles?mode=Slide","/games/puzzles?mode=Sokoban","/games/dots-connect","/games/one-line","/games/trail-making","/games/navigator","/games/puzzles?mode=Net","/games/puzzles?mode=Netslide","/games/puzzles?mode=Twiddle","/games/puzzles?mode=Cube","/games/puzzles?mode=Flip","/games/puzzles?mode=Sixteen","/games/puzzles?mode=Fifteen","/games/puzzles?mode=Untangle"],"/games/sorting-hub":["/games/goods-sort","/games/water-sort","/games/ball-sort","/games/nut-sort","/games/cake-sort","/games/pizza-sort","/games/hanoi","/games/tower-london","/games/puzzles?mode=Pegs","/games/puzzles?mode=Flood","/games/puzzles?mode=Same%20Game","/games/puzzles?mode=Signpost","/games/puzzles?mode=Inertia","/games/puzzles?mode=Loopy","/games/puzzles?mode=Pearl","/games/puzzles?mode=Bridges","/games/puzzles?mode=Train%20Tracks"],"/games/counting-hub":["/games/counter","/games/math-slider","/games/number-run","/games/math-sprint","/games/number-bonds","/games/ospan","/games/pattern","/games/puzzles?mode=Mines","/games/puzzles?mode=Mosaic","/games/puzzles?mode=Pattern","/games/puzzles?mode=Range","/games/puzzles?mode=Magnets","/games/puzzles?mode=Galaxies","/games/puzzles?mode=Palisade"],"/games/search-hub":["/games/visual-search","/games/find-differences","