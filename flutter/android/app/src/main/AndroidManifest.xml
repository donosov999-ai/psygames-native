<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- `android:label` — подпись под значком на экране телефона. Шаблонное
         «psygames_flutter» человек увидел бы вместо имени приложения; прежняя
         линия в Play подписана «PsyGames», и при обновлении поверх имя меняться
         не должно.
         ⚠️ Комментарий стоит ЗДЕСЬ, а не между атрибутами: внутри открывающего
         тега он делает XML невалидным, и сборка падает «Error parsing LocalFile»,
         возвращая при этом код выхода 0. Замер 25.09.2026. -->
    <!-- 🔴 INTERNET ОБЯЗАТЕЛЕН И В РЕЛИЗЕ. Веб-часть отдаёт свой сервер на 127.0.0.1
         (lib/shell/asset_server.dart, HttpServer.bind) — без этого разрешения Android
         запрещает даже петлевой сокет: «Failed to create server socket, errno = 1», пустой
         экран на старте. Строка стояла только в src/debug и src/profile, поэтому flutter run
         работал, а релиз 2.56.0 во внутреннем треке Play не запускался (01.10.2026, нашёл
         раздел «Поиск»). Сторож — flutter/test/android_release_manifest_test.dart. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Вибросопровождение практик «Паузы» (PracticeHaptics.kt): Vibrator без него молчит. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- 🎤 Голосовая заметка в отзыве (c092cd47). Записывает страница (getUserMedia в WebView), но Android
         отдаёт WebView микрофон только приложению, которому человек выдал RECORD_AUDIO (спрашивает
         MainActivity, канал psygames/mic, и только по нажатию «Записать голосом»). MODIFY_AUDIO_SETTINGS
         WebView нужен для захвата звука. Замер 07.10.2026: в APK 2.56.15 разрешения нет — с 2.56.0
         голос в 0 отзывах из 13 (на 2.54.22 — в 2 из 25). Сторож — flutter/test/mic_permission_test.dart. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- networkSecurityConfig: открытый http разрешён только на 127.0.0.1 — туда WebView ходит
         за веб-частью; без него релиз даёт ERR_CLEARTEXT_NOT_PERMITTED (res/xml/network_security_config.xml). -->
    <application
        android:label="PsyGames"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
